#: ../src/cairo-clock.c:830
msgid "# This file is machine-generated."
msgstr "# Este archivo se genera automáticamente."

#: ../src/cairo-clock.c:831
msgid "Do not edit it manually!"
msgstr "¡No editar manualmente!"

#: ../src/cairo-clock.c:832
msgid "I really mean it!!!"
msgstr "¡¡¡Queda avisado!!!"

#: ../src/cairo-clock.c:875
#, c-format
msgid "Ups, there was an error while trying to save the preferences!\n"
msgstr "¡Oh, se ha producido un error al intentar guardas las preferencias!\n"

#: ../src/cairo-clock.c:1330
msgid "x-position of the top-left window-corner"
msgstr "posición x de la esquina superior izquierda de la ventana"

#: ../src/cairo-clock.c:1337
msgid "y-position of the top-left window-corner"
msgstr "posición y de la esquina superior izquierda de la ventana"

#: ../src/cairo-clock.c:1344
msgid "open window with this width"
msgstr "abrir ventana con este ancho"

#: ../src/cairo-clock.c:1351
msgid "open window with this height"
msgstr "abrir ventana con esta altura"

#: ../src/cairo-clock.c:1358
msgid "draw seconds hand"
msgstr "dibujar manecilla de los segundos"

#: ../src/cairo-clock.c:1365
msgid "draw date-display"
msgstr "dibujar fecha"

#: ../src/cairo-clock.c:1372
msgid "list installed themes and exit"
msgstr "mostrar temas instalados y salir"

#: ../src/cairo-clock.c:1379
msgid "theme to draw the clock with"
msgstr "tema con el que mostrar el reloj"

#: ../src/cairo-clock.c:1386
msgid "clock-window stays on top of all windows"
msgstr "la ventana del reloj permanece sobre las demás ventanas"

#: ../src/cairo-clock.c:1393
msgid "clock-window shows up in pager"
msgstr "la ventana del reloj aparece en el gestor de escritorios"

#: ../src/cairo-clock.c:1400
msgid "clock-window shows up in taskbar"
msgstr "la ventana del reloj aparece en la barra de tareas"

#: ../src/cairo-clock.c:1407
msgid "clock-window sticks to all workspaces"
msgstr "la ventana del reloj aparece en todos los escritorios"

#: ../src/cairo-clock.c:1414
msgid "hands work in 12 hour mode"
msgstr "las manecillas funcionan en modo de 12h"

#: ../src/cairo-clock.c:1421
msgid "hands work in 24 hour mode"
msgstr "las manecillas funcionan en modo de 24h"

#: ../src/cairo-clock.c:1428
msgid "render at RATE (default: 30 Hz)"
msgstr "Frecuencia de refresco (por defecto: 30 Hz)"

#: ../src/cairo-clock.c:1435
msgid "print version of program and exit"
msgstr "mostrar versión del programa y salir"

#. setup and process command-line options
#: ../src/cairo-clock.c:1455
msgid "- analog clock drawn with vector-graphics"
msgstr "- reloj analógico dibujado con gráficos vectoriales"

