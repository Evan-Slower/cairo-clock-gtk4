#: ../desktop/cairo-clock.desktop.in.h:1 ../glade/cairo-clock.glade.h:288
#: ../src/cairo-clock.c:1638
msgid "MacSlow's Cairo-Clock"
msgstr "MacSlow's Cairo-Uhr"

#: ../desktop/cairo-clock.desktop.in.h:2
msgid "a super fine analog clock"
msgstr "eine total tolle Analoguhr"

#: ../glade/cairo-clock.glade.h:1
msgid "(C) 2006 - 2007 Mirco \"MacSlow\" Müller"
msgstr "(C) 2006 - 2007 Mirco \"MacSlow\" Müller"

#: ../glade/cairo-clock.glade.h:1.5
msgid "A 20th anniversary GTK4 port by Evan Slower\nof MacSlow's super fine Cairo-based analog clock"
msgstr "Ein GTK4-Port zum 20. Jubiläum von Evan Slower\nder super feinen Cairo-basierten Analoguhr von MacSlow"

#: ../glade/cairo-clock.glade.h:2
msgid "<b>Animation Smoothness</b>"
msgstr "<b>Animationsqualität</b>"

#: ../glade/cairo-clock.glade.h:3
msgid "<b>Display Options</b>"
msgstr "<b>Darstellungsoptionen</b>"

#: ../glade/cairo-clock.glade.h:4
msgid "<b>Startup Size</b>"
msgstr "<b>Startgröße</b>"

#: ../glade/cairo-clock.glade.h:5
msgid "<b>Theme</b>"
msgstr "<b>Motiv</b>"

#: ../glade/cairo-clock.glade.h:6
msgid "Appear in pager"
msgstr "Im Pager erscheinen"

#: ../glade/cairo-clock.glade.h:7
msgid "Appear in taskbar"
msgstr "Im Taskbar erscheinen"

#: ../glade/cairo-clock.glade.h:285
msgid "Height:"
msgstr "Höhe:"

#: ../glade/cairo-clock.glade.h:286
msgid "About"
msgstr "Informationen"

#: ../glade/cairo-clock.glade.h:287
msgid "Keep on top"
msgstr "Immer über allen anderen Fenstern bleiben"

#: ../glade/cairo-clock.glade.h:289
msgid "MacSlow's Cairo-Clock - Error"
msgstr "MacSlow's Cairo-Clock - Fehler"

#: ../glade/cairo-clock.glade.h:290
msgid "MacSlow's Cairo-Clock - Information"
msgstr "MacSlow's Cairo-Clock - Informationen"

#: ../glade/cairo-clock.glade.h:291
msgid "MacSlow's Cairo-Clock - Settings"
msgstr "MacSlow's Cairo-Clock - Einstellungen"

#: ../glade/cairo-clock.glade.h:292
msgid "Settings"
msgstr "Eigenschaften"

#: ../glade/cairo-clock.glade.h:293
msgid "Quit"
msgstr "Beenden"

#: ../glade/cairo-clock.glade.h:294
msgid "Show date"
msgstr "Datum anzeigen"

#: ../glade/cairo-clock.glade.h:295
msgid "Show seconds"
msgstr "Sekundenzeiger anzeigen"

#: ../glade/cairo-clock.glade.h:296
msgid "Stick to every workspace"
msgstr "Auf jedem Arbeitsplatz erscheinen"

#: ../glade/cairo-clock.glade.h:297
msgid "Use 24h mode"
msgstr "24-Stunden Modus verwenden"

#: ../glade/cairo-clock.glade.h:298
msgid "Width:"
msgstr "Breite:"

#: ../glade/cairo-clock.glade.h:299
msgid "an analog clock based on vector-graphics"
msgstr "eine analoge Uhr die mit Vektorgrafik dargestellt wird"

#: ../glade/cairo-clock.glade.h:300
msgid "cairo-clock Homepage"
msgstr "Homepage von cairo-clock"

#: ../glade/cairo-clock.glade.h:301
msgid "close this settings-dialog"
msgstr "diesen Einstellungsdialog schließen"

#: ../glade/cairo-clock.glade.h:302
msgid "get information on all settings-options"
msgstr "Informatioinen über alle Einstellungsmöglichkeiten"

#: ../glade/cairo-clock.glade.h:303
msgid "If enabled the clock will stick to all workspaces"
msgstr "Wenn aktiviert, bleibt die Uhr auf allen Arbeitsbereichen haften"

#: ../glade/cairo-clock.glade.h:304
msgid "if enabled, the clock window will be kept above all other windows"
msgstr "wenn ausgewählt wird das Fenster der Uhr über allen anderen Fenstern bleiben"

#: ../glade/cairo-clock.glade.h:305
msgid "if enabled, the current date will be displayed inside the clocks face"
msgstr "wenn ausgewählt wird das akuelle Datum in der Uhr angezeigt"

#: ../glade/cairo-clock.glade.h:306
msgid "if enabled, the seconds hand will be drawn"
msgstr "wenn ausgewählt wird der Sekundenzeiger gezeichnet"

#: ../glade/cairo-clock.glade.h:307
msgid "if enabled, the window of the clock will be shown in the taskbar"
msgstr "wenn ausgewählt erscheint das Fenster der Uhr im Taskbar"

#: ../glade/cairo-clock.glade.h:307.5
msgid "Display time in 24-hour format"
msgstr "Zeit im 24-Stunden-Format anzeigen"

#: ../glade/cairo-clock.glade.h:308
msgid "initial window-height when program starts"
msgstr "Fensterhöhe beim Programmstart"

#: ../glade/cairo-clock.glade.h:309
msgid "initial window-width when program starts"
msgstr "Fensterbreite beim Programmstart"

#: ../glade/cairo-clock.glade.h:310
msgid "rough"
msgstr "grob"

#: ../glade/cairo-clock.glade.h:311
msgid "Small (150x150)"
msgstr "Klein (150x150)"

msgid "Medium (250x250)"
msgstr "Mittel (250x250)"

msgid "Large (350x350)"
msgstr "Groß (350x350)"

msgid "Custom 1"
msgstr "Speziell 1"

msgid "Custom 2"
msgstr "Speziell 2"

#: ../glade/cairo-clock.glade.h:315
msgid "smooth"
msgstr "fein"

#. TRANSLATORS: Replace this string with your names, one name per line.
